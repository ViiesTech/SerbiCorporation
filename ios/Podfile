# Resolve react_native_pods.rb with node to allow for hoisting
require Pod::Executable.execute_command('node', ['-p',
  'require.resolve(
    "react-native/scripts/react_native_pods.rb",
    {paths: [process.argv[1]]},
  )', __dir__]).strip

platform :ios, min_ios_version_supported
prepare_react_native_project!

$RNFirebaseDisableSPM = true
$RNFirebaseAsStaticFramework = true

linkage = ENV['USE_FRAMEWORKS']
if linkage != nil
  Pod::UI.puts "Configuring Pod with #{linkage}ally linked Frameworks".green
  use_frameworks! :linkage => linkage.to_sym
end

target 'SerbiCorporation' do
  config = use_native_modules!

  use_react_native!(
    :path => config[:reactNativePath],
    # An absolute path to your application root.
    :app_path => "#{Pod::Config.instance.installation_root}/.."
  )

    # FirebaseCoreInternal is Swift and needs GoogleUtilities to expose a module map.
  pod 'GoogleUtilities', :modular_headers => true
  pod 'FirebaseCoreInternal', :modular_headers => true
  pod 'FirebaseCore', :modular_headers => true
  pod 'FirebaseCoreExtension', :modular_headers => true
  pod 'FirebaseInstallations', :modular_headers => true
  pod 'FirebaseMessaging', :modular_headers => true

  pod 'react-native-maps', :path => '../node_modules/react-native-maps', :subspecs => ['Google']
  
  post_install do |installer|
    # https://github.com/facebook/react-native/blob/main/packages/react-native/scripts/react_native_pods.rb#L197-L202
    react_native_post_install(
      installer,
      config[:reactNativePath],
      :mac_catalyst_enabled => false,
      # :ccache_enabled => true
    )

    # 1. Fix fmt compilation error with Apple Clang (Xcode 16+ / C++20 consteval)
    fmt_base = File.join(installer.sandbox.root, 'fmt', 'include', 'fmt', 'base.h')
    if File.exist?(fmt_base)
      content = File.read(fmt_base)
      unless content.include?('Apple Clang workaround: disable consteval')
        patched = content.gsub(
          /#elif defined\(__apple_build_version__\) && __apple_build_version__ < 14000029L/,
          "#elif defined(__apple_build_version__)"
        ).gsub(
          /(#elif defined\(__cpp_consteval\)\s*\n#\s*define FMT_USE_CONSTEVAL\s+)1/,
          "// Apple Clang workaround: disable consteval\n\\10"
        )
        if patched != content
          File.chmod(0644, fmt_base)
          File.write(fmt_base, patched)
          Pod::UI.puts "Patched fmt/base.h to disable consteval for Apple Clang compatibility".green
        end
      end
    end

    # 2. Fix stripe-react-native STPPaymentStatus enum mismatch (NSInteger vs NSUInteger)
    stripe_interop = File.join(installer.sandbox.root, '../node_modules/@stripe/stripe-react-native/ios/StripeSwiftInterop.h')
    if File.exist?(stripe_interop)
      content = File.read(stripe_interop)
      if content.include?('typedef NS_ENUM(NSUInteger, STPPaymentStatus);')
        patched = content.gsub('typedef NS_ENUM(NSUInteger, STPPaymentStatus);', 'typedef NS_ENUM(NSInteger, STPPaymentStatus);')
        File.chmod(0644, stripe_interop)
        File.write(stripe_interop, patched)
        Pod::UI.puts "Patched StripeSwiftInterop.h for STPPaymentStatus integer type compatibility".green
      end
    end

    # 3. Fix deployment target warnings for all pod targets (including resource bundles)
    installer.pods_project.targets.each do |target|
      target.build_configurations.each do |config|
        if config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'].to_f < 15.1
          config.build_settings['IPHONEOS_DEPLOYMENT_TARGET'] = '15.1'
        end
      end

      # 4. Fix Run Script build phase warnings (dependency analysis) for pod targets
      target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |phase|
        has_outputs = (phase.output_paths && !phase.output_paths.empty?) ||
                      (phase.output_file_list_paths && !phase.output_file_list_paths.empty?)
        if !has_outputs
          phase.always_out_of_date = '1'
        end
      end
    end

    # 5. Fix Run Script build phase warnings (dependency analysis) for user project targets
    installer.aggregate_targets.each do |aggregate_target|
      aggregate_target.user_project.targets.each do |target|
        target.build_phases.grep(Xcodeproj::Project::Object::PBXShellScriptBuildPhase).each do |phase|
          has_outputs = (phase.output_paths && !phase.output_paths.empty?) ||
                        (phase.output_file_list_paths && !phase.output_file_list_paths.empty?)
          if !has_outputs
            phase.always_out_of_date = '1'
          end
        end
      end
      aggregate_target.user_project.save
    end
  end
end
